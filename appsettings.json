{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "Sqlite",
  "ConnectionStrings": {
    "Sqlite": "Data Source=flowershop.db",
    "SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=FlowerShop;Trusted_Connection=True;"
  },
  "Jwt": {
    "Issuer": "FlowerShop",
    "Audience": "FlowerShopClients",
    "ExpireMinutes": 60
}
}
